# Local-only Supabase credentials for vocabulary audio upload.
# Copy to .env.local and fill values in your editor. Never commit or share the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Learner-facing reads. The publishable key is public by design; RLS decides
# what it can see. Never put the service-role key here or in the app runtime.
SUPABASE_PUBLISHABLE_KEY=
# `supabase` serves the real catalog; `fixture` serves the 20-card slice.
VOCABULARY_CONTENT_SOURCE=supabase

# Audio release gate (ADR-003). Both must be set before any audio is served.
VOCABULARY_AUDIO_ENABLED=false
VOCABULARY_AUDIO_BASE_URL=
